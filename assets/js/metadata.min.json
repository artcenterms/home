---
# metadata for table ajax
---
{%- assign fields = site.data.config-table | map: 'field' -%}
{ "objects": [
{%- assign first_data_item = true -%}
{%- for item in site.data[site.metadata] -%}
{%- if item.objectid -%}
{%- assign include_data_item = false -%}
{%- if site.data.theme.data-child-objects == true -%}
{%- assign include_data_item = true -%}
{%- elsif item.parentid == nil or item.parentid == '' -%}
{%- assign include_data_item = true -%}
{%- endif -%}
{%- if include_data_item -%}
{%- unless first_data_item -%},{%- endunless -%}
[ {% for f in fields %}{% if item[f] %}{{ item[f] | jsonify }}{% else %}""{% endif %},{% endfor %} "{{ '/items/' | relative_url }}{% if item.parentid %}{{ item.parentid }}.html#{{ item.objectid }}{% else %}{{ item.objectid }}.html{% endif %}" ]
{%- assign first_data_item = false -%}
{%- endif -%}
{%- endif -%}
{% endfor %}
] }
